	"tokenColors": [
		{
			"settings": {
				"foreground": "#CAD3F5"
			}
		},
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#707AA6",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["comment.block.documentation", "comment.line.documentation"],
			"settings": {
				"foreground": "#CBCDFC",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["comment.block.documentation keyword", "keyword.other.documentation"],
			"settings": {
				"foreground": "#FCEDCC",
				"fontStyle": "bold italic"
			}
		},
		{
			"scope": "string",
			"settings": {
				"foreground": "#ADB3E0"
			}
		},
		{
			"scope": ["string.regexp"],
			"settings": {
				"foreground": "#BEDEC5"
			}
		},
		{
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#F5BDE6"
			}
		},
		{
			"scope": ["invalid.illegal", "constant.character.escape.invalid"],
			"settings": {
				"foreground": "#EF8AB7"
			}
		},
		{
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#F9E2AF"
			}
		},
		{
			"scope": ["constant.language", "keyword.constant", "support.constant"],
			"settings": {
				"foreground": "#B7BDF8",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["constant.other", "variable.other.constant"],
			"settings": {
				"foreground": "#CBCDFC"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator.word",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#E9A6F5"
			}
		},
		{
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#E9A6F5"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#9092FD"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"storage.type.class"
			],
			"settings": {
				"foreground": "#EED49F"
			}
		},
		{
			"scope": "entity.name.type.parameter",
			"settings": {
				"foreground": "#B7BDF8"
			}
		},
		{
			"scope": ["variable", "variable.other.readwrite"],
			"settings": {
				"foreground": "#CBCDFC"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#CCCBFF"
			}
		},
		{
			"scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key"],
			"settings": {
				"foreground": "#A6DAFF"
			}
		},
		{
			"scope": ["variable.language", "variable.language.this"],
			"settings": {
				"foreground": "#B7BDF8",
				"fontStyle": "italic bold"
			}
		},
		{
			"scope": ["entity.name.function.member.static", "variable.other.property.static"],
			"settings": {
				"foreground": "#9BF8EA"
			}
		},
		{
			"scope": ["entity.other.attribute-name", "meta.attribute"],
			"settings": {
				"foreground": "#EED49F"
			}
		},
		{
			"scope": ["storage.type.annotation", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
			"settings": {
				"foreground": "#F0C6C6",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["keyword.other.preprocessor", "meta.preprocessor", "entity.name.function.preprocessor"],
			"settings": {
				"foreground": "#C6A0F6"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#E9A6F5"
			}
		},
		{
			"scope": ["punctuation.definition.tag", "punctuation.tag"],
			"settings": {
				"foreground": "#CAD3F5"
			}
		},
		{
			"scope": [
				"punctuation",
				"punctuation.separator",
				"punctuation.terminator",
				"meta.brace",
				"meta.delimiter"
			],
			"settings": {
				"foreground": "#8A92B8"
			}
		},
		{
			"scope": ["punctuation.accessor", "punctuation.separator.period"],
			"settings": {
				"foreground": "#8189A8"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#B7BDF8",
				"fontStyle": "underline"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#F5A97F"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#EED49F"
			}
		},
		{
			"scope": ["markup.heading"],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#8AADF4"
			}
		},
		{
			"scope": ["markup.quote"],
			"settings": {
				"foreground": "#A6DA95",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code.block"],
			"settings": {
				"foreground": "#ADB3E0"
			}
		},
		{
			"scope": ["meta.diff.header", "punctuation.definition.diff.range"],
			"settings": {
				"foreground": "#8AADF4"
			}
		},
		{
			"scope": ["markup.inserted", "diff.inserted"],
			"settings": {
				"foreground": "#A6DA95"
			}
		},
		{
			"scope": ["markup.deleted", "diff.deleted"],
			"settings": {
				"foreground": "#ED8796"
			}
		},
		{
			"scope": ["support.type.property-name.json", "string.json support.type.property-name"],
			"settings": {
				"foreground": "#9092FD"
			}
		},
		{
			"scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css"],
			"settings": {
				"foreground": "#F3B9FF"
			}
		},
		{
			"scope": ["support.function.name.css", "meta.function-call.css"],
			"settings": {
				"foreground": "#91D7E3",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["support.type.property-name.css"],
			"settings": {
				"foreground": "#A8D7FC"
			}
		},
		{
			"scope": ["meta.property-value.css", "support.constant.property-value.css"],
			"settings": {
				"foreground": "#EED49F"
			}
		},
		{
			"scope": ["keyword.control.at-rule.css", "punctuation.definition.keyword.css"],
			"settings": {
				"foreground": "#CAB0FF"
			}
		},
		{
			"scope": ["entity.other.attribute-name.id.css", "constant.other.color.rgb-value.css"],
			"settings": {
				"foreground": "#9092FD"
			}
		},
		{
			"scope": ["variable.parameter.url.css", "string.quoted.string.css"],
			"settings": {
				"foreground": "#A6DA95"
			}
		}
	]
}
